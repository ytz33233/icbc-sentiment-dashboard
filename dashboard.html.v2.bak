// ===================== 全局状态 =====================
let loadedData = null;
let filteredData = [];
let currentPage = 1;
let sortState = { field: null, order: 'desc' };

function formatDate(d) {
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
}

// 获取北京时间（Asia/Shanghai）今天的日期字符串 YYYY-MM-DD
// 不依赖 locale 格式，使用 UTC 偏移计算，确保跨浏览器一致性
function getTodayBeijing() {
  const now = new Date();
  const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
  const beijingTime = new Date(utc + (3600000 * 8));
  const yyyy = beijingTime.getFullYear();
  const mm = String(beijingTime.getMonth() + 1).padStart(2, '0');
  const dd = String(beijingTime.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
}

function getSentimentLabel(s) { return CONFIG.labels.sentiment[s] || s; }
function getSourceLabel(t) { return CONFIG.labels.source[t] || t; }
function getRecencyLabel(r) { return CONFIG.labels.recency[r] || r; }

function emptyData(dateStr) {
  return {
    reportDate: dateStr,
    summary: { total: 0, recentCount: 0, historyCount: 0, negativeCount: 0, negativePct: 0, positiveCount: 0, neutralCount: 0, channelCount: 0, highRiskCount: 0 },
    bySource: {}, bySentiment: {}, byRisk: {}, byProduct: {}, byCategory: {},
    trend7d: [], hotKeywords: [], records: []
  };
}

// ===================== 数据加载 =====================
async function fetchJson(dateStr) {
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 5000);
    const res = await fetch(`${CONFIG.dataDir}${dateStr}.json`, { cache: 'no-store', signal: controller.signal });
    clearTimeout(timeoutId);
    if (!res.ok) return null;
    return await res.json();
  } catch (e) {
    return null;
  }
}

async function loadSingleDate(dateStr) {
  const data = await fetchJson(dateStr);
  if (data) {
    loadedData = data;
  } else if (window.location.protocol === 'file:') {
    loadedData = fallbackData;
  } else {
    loadedData = emptyData(dateStr);
  }
  currentPage = 1;
  applyFilters();
}

async function loadByRange(startStr, endStr) {
  const start = new Date(startStr);
  const end = new Date(endStr);
  if (isNaN(start) || isNaN(end) || start > end) {
    alert('时间范围无效');
    return;
  }

  let allRecords = [];
  let allHotKeywords = [];
  for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
    const dateStr = formatDate(d);
    const data = await fetchJson(dateStr);
    if (data && data.records && data.records.length) {
      allRecords = allRecords.concat(data.records);
      // 合并热词
      (data.hotKeywords || []).forEach(k => {
        const existing = allHotKeywords.find(x => x.word === k.word);
        if (existing) {
          existing.count += k.count;
        } else {
          allHotKeywords.push({ word: k.word, count: k.count });
        }
      });
    }
  }

  // 未获取到任何数据时回退到 fallback（直接使用全部 fallback 数据）
  if (allRecords.length === 0) {
    allRecords = fallbackData.records || [];
    allHotKeywords = fallbackData.hotKeywords || [];
  }

  // 去重（按 id）
  const seen = new Set();
  const uniqueRecords = allRecords.filter(r => {
    if (seen.has(r.id)) return false;
    seen.add(r.id);
    return true;
  });

  // 全局过滤：只保留最近7天
  const filteredRecords = filterWithin7Days(uniqueRecords);

  // 热词排序取前20
  allHotKeywords.sort((a, b) => b.count - a.count);
  allHotKeywords = allHotKeywords.slice(0, 20);

  // 重新计算统计（基于过滤后的数据）
  const stats = computeStats(filteredRecords);
  const trend = computeTrend(filteredRecords, startStr, endStr);

  loadedData = {
    reportDate: `${startStr} ~ ${endStr}`,
    records: filteredRecords,
    summary: stats.summary,
    bySentiment: stats.bySentiment,
    bySource: stats.bySource,
    byRisk: stats.byRisk,
    byProduct: stats.byProduct,
    trend7d: trend,
    hotKeywords: allHotKeywords
  };

  // 应用当前筛选条件并刷新 UI
  applyFilters();
  updateUI();
}

// 从基准日期字符串（YYYY-MM-DD）减去指定天数，返回新的日期字符串
function getDateStrBefore(baseStr, days) {
  const [yyyy, mm, dd] = baseStr.split('-').map(Number);
  const d = new Date(yyyy, mm - 1, dd);
  d.setDate(d.getDate() - days);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

async function loadLatest() {
  const todayStr = getTodayBeijing();
  const weekAgoStr = getDateStrBefore(todayStr, 6);
  console.log('[loadLatest] 加载最近7天:', weekAgoStr, '~', todayStr);
  document.getElementById('filter-date-start').value = weekAgoStr;
  document.getElementById('filter-date-end').value = todayStr;
  await loadByRange(weekAgoStr, todayStr);
}

// ===================== 日期工具 =====================
function getDateStrBefore(baseStr, days) {
  const [yyyy, mm, dd] = baseStr.split('-').map(Number);
  const d = new Date(yyyy, mm - 1, dd);
  d.setDate(d.getDate() - days);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

// 只保留最近7天内的记录（今天 + 前6天）
function filterWithin7Days(records) {
  const todayStr = getTodayBeijing();
  const weekAgoStr = getDateStrBefore(todayStr, 6);
  return records.filter(r => {
    const d = (r.date || '').toString().slice(0, 10);
    return d >= weekAgoStr;
  });
}

// ===================== 统计计算 =====================
function computeStats(records) {
  // 全局过滤：只统计最近7天内的数据
  records = filterWithin7Days(records);
  const total = records.length;
  const negativeCount = records.filter(r => r.sentiment === 'negative').length;
  const positiveCount = records.filter(r => r.sentiment === 'positive').length;
  const neutralCount = records.filter(r => r.sentiment === 'neutral').length;
  const negPct = total > 0 ? Math.round((negativeCount / total) * 100) : 0;
  const highRiskCount = records.filter(r => r.riskLevel === 'high').length;
  const channelCount = new Set(records.map(r => r.sourceType)).size;
  const recentCount = records.filter(r => r.recency === '24h内').length;
  const historyCount = records.filter(r => r.recency === '历史').length;

  const bySentiment = { positive: positiveCount, negative: negativeCount, neutral: neutralCount };
  const bySource = {}; const byRisk = {}; const byProduct = {};
  records.forEach(r => {
    bySource[r.sourceType] = (bySource[r.sourceType] || 0) + 1;
    byRisk[r.riskLevel] = (byRisk[r.riskLevel] || 0) + 1;
    byProduct[r.relatedProduct || '其他'] = (byProduct[r.relatedProduct || '其他'] || 0) + 1;
  });

  return {
    summary: { total, recentCount, historyCount, negativeCount, negativePct: negPct, positiveCount, neutralCount, channelCount, highRiskCount },
    bySentiment, bySource, byRisk, byProduct
  };
}

function computeTrend(records, startStr, endStr) {
  const start = new Date(startStr);
  const end = new Date(endStr);
  const days = Math.max(1, Math.ceil((end - start) / 86400000) + 1);
  const trend = [];

  for (let i = 0; i < days; i++) {
    const d = new Date(start);
    d.setDate(d.getDate() + i);
    const ds = formatDate(d);
    // 按舆情发生日期（date）分组，统一展示舆情发生时间的分布
    const dayRecords = records.filter(r => {
      const pubDate = (r.date || '').toString().slice(0, 10);
      return pubDate === ds;
    });
    const recent = dayRecords.filter(r => r.recency === '24h内').length;
    const history = dayRecords.filter(r => r.recency === '历史').length;
    trend.push({
      date: ds,
      total: dayRecords.length,
      recent, history,
      negative: dayRecords.filter(r => r.sentiment === 'negative').length
    });
  }
  return trend;
}

// ===================== UI 渲染（Editorial Dark Terminal）=====================

function updateUI() {
  renderSummary();
  renderKPI();
  renderSentimentDonut();
  renderSourceBars();
  renderTrendLine();
  renderWordCloud();
  renderTable();
  updateReportDate();
}

function updateReportDate() {
  const el = document.getElementById("report-date");
  if (el && loadedData && loadedData.reportDate) {
    el.textContent = loadedData.reportDate;
  }
}

function renderKPI() {
  const s = loadedData.summary || {};
  document.getElementById("kpi-total").textContent = s.total || 0;
  document.getElementById("kpi-recent").textContent = s.recentCount || 0;
  document.getElementById("kpi-negative").textContent = s.negativeCount || 0;
  document.getElementById("kpi-positive").textContent = s.positiveCount || 0;
}

function renderSummary() {
  const card = document.getElementById("summary-card");
  const body = document.getElementById("summary-body");
  const meta = document.getElementById("summary-meta");
  const records = filterWithin7Days(loadedData.records || []);
  if (!records.length) { card.style.display = "none"; return; }

  const s = loadedData.summary || {};
  const total = s.total || 0;
  const neg = s.negativeCount || 0;
  const pos = s.positiveCount || 0;
  const neu = s.neutralCount || 0;
  const recent = s.recentCount || 0;

  const kwMap = {};
  records.forEach(r => { (r.keywords || []).forEach(k => { kwMap[k] = (kwMap[k] || 0) + 1; }); });
  const topKw = Object.entries(kwMap).sort((a, b) => b[1] - a[1]).slice(0, 3).map(x => x[0]);

  const srcMap = {};
  records.forEach(r => { srcMap[r.sourceType] = (srcMap[r.sourceType] || 0) + 1; });
  const topSrc = Object.entries(srcMap).sort((a, b) => b[1] - a[1]).slice(0, 2).map(x => CONFIG.labels.source[x[0]] || x[0]);

  const prodMap = {};
  records.forEach(r => { const p = r.relatedProduct || "其他"; prodMap[p] = (prodMap[p] || 0) + 1; });
  const topProd = Object.entries(prodMap).sort((a, b) => b[1] - a[1]).slice(0, 2).map(x => x[0]);

  let text = "";
  if (total === 0) {
    text = "本周暂无相关舆情数据。";
  } else {
    text = "本周共采集 <strong>" + total + "</strong> 条舆情，其中负面 <strong>" + neg + "</strong> 条";
    if (pos > 0) text += "，正面 " + pos + " 条";
    if (neu > 0) text += "，中性 " + neu + " 条";
    text += "。";
    if (recent > 0) text += "24小时内新增 <strong>" + recent + "</strong> 条。";
    text += "主要集中在「" + topProd.join("、") + "」等产品，来源以" + topSrc.join("、") + "为主，热词包括「" + topKw.join("、") + "」。";
  }

  body.innerHTML = text;
  const srcNames = Object.keys(srcMap).map(k => CONFIG.labels.source[k] || k).join('、');
  let updateTime = loadedData.reportDate || '';
  if (updateTime.includes('~')) {
    updateTime = updateTime.split('~').pop().trim();
  }
  updateTime = '更新至 ' + updateTime + ' 15:30:00';
  meta.textContent = updateTime + ' · 渠道：' + srcNames;
  card.style.display = "block";
}

function renderSentimentDonut() {
  const bySentiment = loadedData.bySentiment || {};
  const total = (bySentiment.positive || 0) + (bySentiment.neutral || 0) + (bySentiment.negative || 0);
  const container = document.getElementById("sentiment-chart");

  if (total === 0) {
    container.innerHTML = '<div style="color:var(--text-dim);font-size:13px;">无数据</div>';
    return;
  }

  const colors = CONFIG.colors.sentiment;
  let currentDeg = 0;
  const slices = [];
  ["negative", "neutral", "positive"].forEach(key => {
    const count = bySentiment[key] || 0;
    const deg = (count / total) * 360;
    if (deg > 0) {
      slices.push(colors[key] + " " + currentDeg + "deg " + (currentDeg + deg) + "deg");
      currentDeg += deg;
    }
  });

  const donutStyle = slices.length > 0 ? "conic-gradient(" + slices.join(", ") + ")" : "#222";

  let legendHtml = "";
  ["negative", "neutral", "positive"].forEach(key => {
    const count = bySentiment[key] || 0;
    if (count === 0) return;
    legendHtml += '<div class="donut-legend-item"><span class="donut-legend-bar" style="background:' + colors[key] + ';"></span><span class="donut-legend-text">' + getSentimentLabel(key) + '</span><span class="donut-legend-count">' + count + '</span></div>';
  });

  container.innerHTML = '<div class="donut-container"><div class="donut-chart" style="background:' + donutStyle + ';"><div class="donut-center"><div class="donut-center-value">' + total + '</div><div class="donut-center-label">总计</div></div></div><div class="donut-legend">' + legendHtml + '</div></div>';
}

function renderSourceBars() {
  const bySource = loadedData.bySource || {};
  const types = Object.keys(bySource).filter(k => bySource[k] > 0).sort((a, b) => bySource[b] - bySource[a]);
  const container = document.getElementById("source-chart");

  if (types.length === 0) {
    container.innerHTML = '<div style="color:var(--text-dim);font-size:13px;">无数据</div>';
    return;
  }

  const maxVal = Math.max(...Object.values(bySource));
  const colors = CONFIG.colors.source;

  container.innerHTML = '<div class="bar-chart-dark">' + types.map(type => {
    const val = bySource[type];
    const color = colors[type] || "#607d8b";
    return '<div class="bar-dark-item"><div class="bar-dark-label">' + getSourceLabel(type) + '</div><div class="bar-dark-track"><div class="bar-dark-fill" style="width:0%;background:' + color + ';"></div></div><div class="bar-dark-value">' + val + '</div></div>';
  }).join("") + '</div>';

  requestAnimationFrame(() => {
    container.querySelectorAll(".bar-dark-fill").forEach((el, i) => {
      setTimeout(() => {
        const type = types[i];
        const val = bySource[type];
        const pct = maxVal > 0 ? (val / maxVal) * 100 : 0;
        el.style.width = pct + "%";
      }, i * 80);
    });
  });
}

function renderTrendLine() {
  // 显示5月1日以来的全部数据
  const todayStr = getTodayBeijing();
  const mayStart = '2026-05-01';
  const trend = computeTrend(loadedData.records || [], mayStart, todayStr);
  const container = document.getElementById("trend-chart");

  if (trend.length === 0) {
    container.innerHTML = '<div style="color:var(--text-dim);font-size:13px;">无数据</div>';
    return;
  }

  const width = 800;
  const height = 200;
  const padding = { top: 20, right: 30, bottom: 40, left: 40 };
  const chartW = width - padding.left - padding.right;
  const chartH = height - padding.top - padding.bottom;

  const maxVal = Math.max(...trend.map(d => d.total || 0), 1);
  const maxNeg = Math.max(...trend.map(d => d.negative || 0), 1);

  const xScale = i => padding.left + (i / (trend.length - 1)) * chartW;
  const yScaleTotal = v => padding.top + chartH - (v / maxVal) * chartH;
  const yScaleNeg = v => padding.top + chartH - (v / maxNeg) * chartH;

  const gridY = [0, 0.25, 0.5, 0.75, 1].map(p => {
    const y = padding.top + chartH * (1 - p);
    return '<line x1="' + padding.left + '" y1="' + y + '" x2="' + (width - padding.right) + '" y2="' + y + '" class="grid-line"/>';
  }).join("");

  const xLabels = trend.map((d, i) => {
    const x = xScale(i);
    const label = d.date.slice(5);
    return '<text x="' + x + '" y="' + (height - 12) + '" text-anchor="middle" class="axis-text">' + label + '</text>';
  }).join("");

  const yLabels = [0, 0.5, 1].map(p => {
    const v = Math.round(maxVal * p);
    const y = padding.top + chartH * (1 - p);
    return '<text x="' + (padding.left - 8) + '" y="' + (y + 4) + '" text-anchor="end" class="axis-text">' + v + '</text>';
  }).join("");

  const totalPoints = trend.map((d, i) => xScale(i) + "," + yScaleTotal(d.total || 0)).join(" ");
  const totalPoly = '<polyline points="' + totalPoints + '" class="trend-line total"/>';

  const negPoints = trend.map((d, i) => xScale(i) + "," + yScaleNeg(d.negative || 0)).join(" ");
  const negPoly = '<polyline points="' + negPoints + '" class="trend-line negative"/>';

  const areaPath = "M" + xScale(0) + "," + (padding.top + chartH) + " L" + totalPoints.replace(/ /g, " L") + " L" + xScale(trend.length - 1) + "," + (padding.top + chartH) + " Z";

  const totalDots = trend.map((d, i) => {
    const x = xScale(i);
    const y = yScaleTotal(d.total || 0);
    return '<circle cx="' + x + '" cy="' + y + '" r="3" fill="var(--text-muted)" class="trend-point" onmouseenter="showTrendTip(event, \'' + d.date + '\', ' + d.total + ', ' + d.negative + ', \'total\')" onmouseleave="hideTrendTip()"/>';
  }).join("");

  const negDots = trend.map((d, i) => {
    const x = xScale(i);
    const y = yScaleNeg(d.negative || 0);
    return '<circle cx="' + x + '" cy="' + y + '" r="3" fill="var(--accent)" class="trend-point" onmouseenter="showTrendTip(event, \'' + d.date + '\', ' + d.total + ', ' + d.negative + ', \'negative\')" onmouseleave="hideTrendTip()"/>';
  }).join("");

  // 图例
  const legendHtml = '<div class="trend-legend"><div class="trend-legend-item"><span class="trend-legend-line trend-legend-total"></span><span>舆情总量</span></div><div class="trend-legend-item"><span class="trend-legend-line trend-legend-negative"></span><span>需关注</span></div></div>';

  container.innerHTML = '<div class="line-chart-dark"><svg viewBox="0 0 ' + width + ' ' + height + '" preserveAspectRatio="xMidYMid meet"><defs><linearGradient id="trendGradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--text-muted)" stop-opacity="0.12"/><stop offset="100%" stop-color="var(--text-muted)" stop-opacity="0"/></linearGradient></defs>' + gridY + '<path d="' + areaPath + '" class="trend-area"/>' + totalPoly + negPoly + totalDots + negDots + xLabels + yLabels + '</svg></div>' + legendHtml;
}

function showTrendTip(evt, date, total, negative, type) {
  const chart = document.getElementById("trend-chart");
  let tooltip = chart.querySelector(".trend-tooltip");
  if (!tooltip) {
    tooltip = document.createElement("div");
    tooltip.className = "trend-tooltip";
    chart.appendChild(tooltip);
  }
  tooltip.innerHTML = '<strong>' + date + '</strong><br/>总计: ' + total + ' · 负面: ' + negative;
  tooltip.style.opacity = "1";
  const rect = evt.target.getBoundingClientRect();
  const parentRect = chart.getBoundingClientRect();
  tooltip.style.left = (rect.left - parentRect.left + 10) + "px";
  tooltip.style.top = (rect.top - parentRect.top - 40) + "px";
}

function hideTrendTip() {
  const tooltip = document.querySelector("#trend-chart .trend-tooltip");
  if (tooltip) tooltip.style.opacity = "0";
}

function renderWordCloud() {
  const keywords = loadedData.hotKeywords || [];
  const container = document.getElementById("word-cloud");
  if (keywords.length === 0) {
    container.innerHTML = '<div style="color:var(--text-dim);font-size:13px;">无数据</div>';
    return;
  }
  const maxCount = Math.max(...keywords.map(k => k.count), 1);
  container.innerHTML = keywords.map(k => {
    const size = 12 + (k.count / maxCount) * 10;
    const opacity = 0.5 + (k.count / maxCount) * 0.5;
    return '<span class="word-item-dark" style="font-size:' + size + 'px;opacity:' + opacity + '">' + k.word + '</span>';
  }).join("");
}

function parseDateTs(item) {
  // 优先使用 date（发布日期），而非 fetchTime（采集日期）
  const dt = item.date || item.publishTime || item.fetchTime || '1970-01-01';
  const s = dt.toString().trim();
  const m = s.match(/^(\d{4})-(\d{1,2})(?:-(\d{1,2}))?/);
  if (!m) return 0;
  const yyyy = parseInt(m[1], 10);
  const mm = parseInt(m[2], 10) - 1;
  const dd = m[3] ? parseInt(m[3], 10) : 1;
  return new Date(yyyy, mm, dd).getTime();
}

function sortTable(field) {
  if (sortState.field === field) {
    sortState.order = sortState.order === 'asc' ? 'desc' : 'asc';
  } else {
    sortState.field = field;
    sortState.order = 'desc';
  }
  currentPage = 1;
  renderTable();
}

// ===================== 表格 =====================
function renderTable() {
  const total = filteredData.length;
  document.getElementById('total-count').textContent = total;

  const tbody = document.getElementById('data-tbody');

  if (total === 0) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty-state">暂无数据</td></tr>';
    document.getElementById('pagination').innerHTML = '';
    renderMobileCards([]);
    return;
  }

  // 应用排序
  let sortedData = [...filteredData];
  if (sortState.field) {
    sortedData.sort((a, b) => {
      let va = a[sortState.field] || '';
      let vb = b[sortState.field] || '';

      if (sortState.field === 'date') {
        va = parseDateTs(a);
        vb = parseDateTs(b);
      } else if (sortState.field === 'sentiment') {
        const order = { negative: 3, neutral: 2, positive: 1 };
        va = order[va] || 0;
        vb = order[vb] || 0;
      } else if (sortState.field === 'heatScore') {
        va = Number(va) || 0;
        vb = Number(vb) || 0;
      } else if (sortState.field === 'category') {
        va = va || '';
        vb = vb || '';
      }

      if (va < vb) return sortState.order === 'asc' ? -1 : 1;
      if (va > vb) return sortState.order === 'asc' ? 1 : -1;
      // 主字段相同 → 按日期倒序（最新在前）
      return parseDateTs(b) - parseDateTs(a);
    });
  } else {
    // 默认排序：热度降序 + 时间倒序
    sortedData.sort((a, b) => {
      const ha = Number(a.heatScore) || 0;
      const hb = Number(b.heatScore) || 0;
      if (ha !== hb) return hb - ha; // 降序：热度高在前
      return parseDateTs(b) - parseDateTs(a); // 同热度下日期倒序
    });
  }

  const start = (currentPage - 1) * CONFIG.pageSize;
  const pageData = sortedData.slice(start, start + CONFIG.pageSize);

  tbody.innerHTML = pageData.map(item => {
    const kwHtml = (item.keywords || []).slice(0, 2).map(k =>
      `<span style="display:inline-block;padding:2px 6px;background:var(--bg-elevated);border:1px solid var(--border);border-radius:4px;font-size:11px;margin:1px;color:var(--text-muted);">${k}</span>`
    ).join('');

    const catClass = 'tag-category-' + (item.category || '其他');
    const catLabel = CONFIG.labels.category[item.category] || item.category || '其他';
    const heatClass = (item.heatScore || 0) >= 100 ? 'heat-score heat-score-high' : 'heat-score';

    return `
      <tr>
        <td>${item.date}</td>
        <td>${item.source}</td>
        <td><span class="tag ${catClass}">${catLabel}</span></td>
        <td>
          <div class="${heatClass}">🔥 ${item.heatScore || 0}</div>
          <div class="heat-metrics">
            <span>👍 ${item.likes || 0}</span>
            <span>💬 ${item.comments || 0}</span>
            <span>⭐ ${item.favorites || 0}</span>
          </div>
        </td>
        <td><span class="tag tag-sentiment-${item.sentiment}">${getSentimentLabel(item.sentiment)}</span></td>
        <td><div class="content-preview">${item.content}</div></td>
        <td>${kwHtml}</td>
        <td><a href="javascript:void(0)" class="link-btn" onclick="showDetail('${item.id}')">详情</a></td>
      </tr>`;
  }).join('');

  renderPagination(total);
  renderMobileCards(pageData);
  renderMobilePagination(total);
}

function renderPagination(total) {
  const totalPages = Math.ceil(total / CONFIG.pageSize);
  const container = document.getElementById('pagination');

  if (totalPages <= 1) {
    container.innerHTML = '';
    return;
  }

  let html = `<button class="page-btn" onclick="changePage(-1)" ${currentPage === 1 ? 'disabled' : ''}>上一页</button>`;
  for (let i = 1; i <= totalPages; i++) {
    html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
  }
  html += `<button class="page-btn" onclick="changePage(1)" ${currentPage === totalPages ? 'disabled' : ''}>下一页</button>`;
  container.innerHTML = html;
}

function changePage(delta) {
  const totalPages = Math.ceil(filteredData.length / CONFIG.pageSize);
  const newPage = currentPage + delta;
  if (newPage >= 1 && newPage <= totalPages) {
    currentPage = newPage;
    renderTable();
  }
}

function goToPage(page) {
  currentPage = page;
  renderTable();
}

// ===================== 移动端卡片 =====================
function renderMobileCards(pageData) {
  const container = document.getElementById('mobile-card-list');
  if (!container) return;

  if (pageData.length === 0) {
    container.innerHTML = `<div class="empty-state">暂无数据</div>`;
    return;
  }

  container.innerHTML = pageData.map(item => {
    const kwHtml = (item.keywords || []).slice(0, 4).map(k =>
      `<span class="mobile-card-tag">${k}</span>`
    ).join('');

    const sentimentColor = {
      positive: '#37c486',
      negative: '#ef6678',
      neutral: '#6b7b9e'
    }[item.sentiment] || '#6b7b9e';

    const catClass = 'tag-category-' + (item.category || '其他');
    const catLabel = CONFIG.labels.category[item.category] || item.category || '其他';

    return `
      <div class="mobile-card" onclick="showDetail('${item.id}')">
        <div class="mobile-card-head">
          <div class="mobile-card-badges">
            <span class="tag tag-sentiment-${item.sentiment}">${getSentimentLabel(item.sentiment)}</span>
            <span class="tag ${catClass}">${catLabel}</span>
            <span style="font-size:11px;color:var(--text-dim);">${item.source}</span>
          </div>
          <span style="font-size:11px;color:var(--text-dim);">${item.date}</span>
        </div>
        <div class="mobile-card-title">${item.title || item.content}</div>
        <div class="mobile-card-content">${item.content}</div>
        <div style="display:flex;gap:12px;font-size:11px;color:var(--text-dim);margin:6px 0;">
          <span>🔥 ${item.heatScore || 0}</span>
          <span>👍 ${item.likes || 0}</span>
          <span>💬 ${item.comments || 0}</span>
          <span>⭐ ${item.favorites || 0}</span>
        </div>
        <div class="mobile-card-keywords">${kwHtml}</div>
      </div>`;
  }).join('');
}

function renderMobilePagination(total) {
  const container = document.getElementById('mobile-pagination');
  if (!container) return;

  const totalPages = Math.ceil(total / CONFIG.pageSize);
  if (totalPages <= 1) {
    container.innerHTML = '';
    return;
  }

  container.innerHTML = `
    <div>第 ${currentPage} / ${totalPages} 页</div>
    <div style="display:flex;gap:8px;width:100%;">
      <button class="btn btn-secondary" style="flex:1;height:36px;" onclick="changePage(-1)" ${currentPage === 1 ? 'disabled' : ''}>上一页</button>
      <button class="btn btn-primary" style="flex:1;height:36px;" onclick="changePage(1)" ${currentPage === totalPages ? 'disabled' : ''}>下一页</button>
    </div>`;
}

// ===================== 移动端筛选面板 =====================
function openMobileFilter() {
  document.getElementById('mobile-filter-overlay').hidden = false;
  document.getElementById('mobile-filter-panel').hidden = false;
  // 同步桌面端筛选值到移动端
  document.getElementById('mobile-filter-date-start').value = document.getElementById('filter-date-start').value;
  document.getElementById('mobile-filter-date-end').value = document.getElementById('filter-date-end').value;
  document.getElementById('mobile-filter-keyword').value = document.getElementById('filter-keyword').value;
  document.getElementById('mobile-filter-sentiment').value = document.getElementById('filter-sentiment').value;
  document.getElementById('mobile-filter-source').value = document.getElementById('filter-source').value;
  document.getElementById('mobile-filter-category').value = document.getElementById('filter-category').value;
}

function closeMobileFilter() {
  document.getElementById('mobile-filter-overlay').hidden = true;
  document.getElementById('mobile-filter-panel').hidden = true;
}

function applyMobileFilters() {
  document.getElementById('filter-date-start').value = document.getElementById('mobile-filter-date-start').value;
  document.getElementById('filter-date-end').value = document.getElementById('mobile-filter-date-end').value;
  document.getElementById('filter-keyword').value = document.getElementById('mobile-filter-keyword').value;
  document.getElementById('filter-sentiment').value = document.getElementById('mobile-filter-sentiment').value;
  document.getElementById('filter-source').value = document.getElementById('mobile-filter-source').value;
  document.getElementById('filter-category').value = document.getElementById('mobile-filter-category').value;
  closeMobileFilter();
  onQuery();
}

function resetMobileFilters() {
  document.getElementById('mobile-filter-date-start').value = '';
  document.getElementById('mobile-filter-date-end').value = '';
  document.getElementById('mobile-filter-keyword').value = '';
  document.getElementById('mobile-filter-sentiment').value = '';
  document.getElementById('mobile-filter-source').value = '';
  document.getElementById('mobile-filter-category').value = '';
  document.getElementById('filter-date-start').value = '';
  document.getElementById('filter-date-end').value = '';
  document.getElementById('filter-keyword').value = '';
  document.getElementById('filter-sentiment').value = '';
  document.getElementById('filter-source').value = '';
  document.getElementById('filter-category').value = '';
  closeMobileFilter();
  resetFilters();
}

// ===================== 日期过滤（舆情列表只保留最近7天）=====================
function getDateStrBefore(baseStr, days) {
  const [yyyy, mm, dd] = baseStr.split('-').map(Number);
  const d = new Date(yyyy, mm - 1, dd);
  d.setDate(d.getDate() - days);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

function filterWithin7Days(records) {
  const todayStr = getTodayBeijing();
  const weekAgoStr = getDateStrBefore(todayStr, 7);
  return records.filter(r => {
    const d = (r.date || '').toString().slice(0, 10);
    return d >= weekAgoStr;
  });
}

// ===================== 类别筛选栏 =====================
const CATEGORY_LIST = ['i豆兑换', '薅羊毛', '资产达标', '投诉维权', '虚假宣传', '其他'];

function getCategoryLabel(c) { return CONFIG.labels.category[c] || c || '其他'; }

function renderCategoryBar() {
  const container = document.getElementById('category-bar');
  if (!container || !loadedData) return;
  const allRecords = filterWithin7Days(loadedData.records || []);
  const counts = {};
  allRecords.forEach(r => {
    const cat = r.category || '其他';
    counts[cat] = (counts[cat] || 0) + 1;
  });

  let html = `<span class="filter-label" style="margin-right:4px;">类别:</span>`;
  html += `<span class="category-chip ${!document.getElementById('filter-category').value ? 'active' : ''}" onclick="filterByCategory('')">全部 (${allRecords.length})</span>`;
  CATEGORY_LIST.forEach(cat => {
    const count = counts[cat] || 0;
    if (count > 0) {
      const active = document.getElementById('filter-category').value === cat ? 'active' : '';
      html += `<span class="category-chip ${active}" onclick="filterByCategory('${cat}')">${getCategoryLabel(cat)} (${count})</span>`;
    }
  });
  container.innerHTML = html;
}

function syncCategoryBar(selectedCategory) {
  const chips = document.querySelectorAll('#category-bar .category-chip');
  chips.forEach(chip => {
    const cat = chip.getAttribute('onclick').match(/filterByCategory\('([^']*)'\)/);
    if (cat && cat[1] === selectedCategory) {
      chip.classList.add('active');
    } else {
      chip.classList.remove('active');
    }
  });
}

function filterByCategory(cat) {
  document.getElementById('filter-category').value = cat;
  document.getElementById('mobile-filter-category').value = cat;
  applyFilters();
}

// ===================== 筛选 =====================
function applyFilters() {
  const keyword = document.getElementById('filter-keyword').value.trim().toLowerCase();
  const sentiment = document.getElementById('filter-sentiment').value;
  const source = document.getElementById('filter-source').value;
  const category = document.getElementById('filter-category').value;
  let allRecords = loadedData.records || [];
  // 舆情列表只保留最近7天
  allRecords = filterWithin7Days(allRecords);

  filteredData = allRecords.filter(d => {
    if (keyword) {
      const inTitle = (d.title || '').toLowerCase().includes(keyword);
      const inContent = (d.content || '').toLowerCase().includes(keyword);
      const inKeywords = (d.keywords || []).some(k => k.toLowerCase().includes(keyword));
      if (!inTitle && !inContent && !inKeywords) return false;
    }
    if (sentiment && d.sentiment !== sentiment) return false;
    if (source && d.sourceType !== source) return false;
    if (category && d.category !== category) return false;
    return true;
  });

  // 同步类别标签栏高亮
  syncCategoryBar(category);

  currentPage = 1;
  renderTable();
}

function resetFilters() {
  document.getElementById('filter-keyword').value = '';
  document.getElementById('filter-sentiment').value = '';
  document.getElementById('filter-source').value = '';
  document.getElementById('filter-category').value = '';
  filteredData = filterWithin7Days(loadedData.records || []);
  syncCategoryBar('');
  currentPage = 1;
  renderTable();
}

async function onQuery() {
  const startStr = document.getElementById('filter-date-start').value;
  const endStr = document.getElementById('filter-date-end').value;
  if (startStr && endStr) {
    await loadByRange(startStr, endStr);
  } else {
    // 没有时间范围变化，仅应用当前筛选条件
    applyFilters();
  }
}

// ===================== 详情弹窗 =====================
function showDetail(id) {
  const item = (loadedData.records || []).find(d => d.id === id);
  if (!item) return;

  document.getElementById('modal-title').textContent = item.title || '舆情详情';

  const kwHtml = (item.keywords || []).map(k =>
    `<span style="display:inline-block;padding:2px 8px;background:var(--bg-elevated);border:1px solid var(--border);border-radius:4px;font-size:12px;margin:2px;color:var(--text-muted);">${k}</span>`
  ).join('');

  const amountHtml = item.amount && item.amount !== '-' ? `
    <div class="detail-row"><div class="detail-label">涉诉金额</div><div class="detail-value" style="color:#c62828;font-weight:600;">${item.amount}</div></div>` : '';

  const catClass = 'tag-category-' + (item.category || '其他');
  const catLabel = CONFIG.labels.category[item.category] || item.category || '其他';

  document.getElementById('modal-body').innerHTML = `
    <div class="detail-row"><div class="detail-label">发布时间</div><div class="detail-value">${item.date}${item.publishTime && item.publishTime !== item.date ? ' ' + item.publishTime.slice(11) : ''}</div></div>
    <div class="detail-row"><div class="detail-label">信息来源</div><div class="detail-value">${item.source}</div></div>
    <div class="detail-row"><div class="detail-label">发布者</div><div class="detail-value">${item.author}</div></div>
    <div class="detail-row"><div class="detail-label">类别</div><div class="detail-value"><span class="tag ${catClass}">${catLabel}</span></div></div>
    <div class="detail-row"><div class="detail-label">情感倾向</div><div class="detail-value"><span class="tag tag-sentiment-${item.sentiment}">${getSentimentLabel(item.sentiment)}</span></div></div>
    <div class="detail-row"><div class="detail-label">热度</div><div class="detail-value"><span style="font-weight:600;color:var(--gold);">🔥 ${item.heatScore || 0}</span> <span style="color:var(--text-dim);font-size:12px;">(👍${item.likes || 0} 💬${item.comments || 0} ⭐${item.favorites || 0})</span></div></div>
    <div class="detail-row"><div class="detail-label">关键词</div><div class="detail-value">${kwHtml}</div></div>
    <div class="detail-row"><div class="detail-label">标题</div><div class="detail-value" style="font-weight:600;">${item.title}</div></div>
    <div class="detail-row"><div class="detail-label">内容详情</div></div>
    <div class="detail-content">${item.content}</div>
    <div class="detail-row" style="margin-top:20px;"><div class="detail-label">原文链接</div><div class="detail-value"><a href="${item.url}" target="_blank" class="link-btn">${item.url}</a></div></div>
    <div class="detail-row"><div class="detail-label">处理状态</div><div class="detail-value">${item.status}</div></div>
    ${amountHtml}
    <div style="margin-top:24px;padding-top:20px;border-top:1px solid #eee;">
      <div class="chart-title" style="margin-bottom:16px;">舆情处理时间线</div>
      <div class="timeline">
        <div class="timeline-item"><div class="timeline-time">${item.date}</div><div class="timeline-text">舆情发布</div></div>
        <div class="timeline-item"><div class="timeline-time">${item.date}</div><div class="timeline-text">系统收录并标记：${getSentimentLabel(item.sentiment)}</div></div>
        <div class="timeline-item"><div class="timeline-time">${loadedData.reportDate || '今日'}</div><div class="timeline-text">当前状态：${item.status}</div></div>
      </div>
    </div>`;

  document.getElementById('modal').classList.add('active');
}

function closeModal() {
  document.getElementById('modal').classList.remove('active');
}

// ===================== 触摸滑动支持 =====================
let mobileFilterTouchStartY = 0;
let mobileFilterTouchCurrentY = 0;

function initMobileFilterSwipe() {
  const panel = document.getElementById('mobile-filter-panel');
  if (!panel) return;
  
  panel.addEventListener('touchstart', function(e) {
    mobileFilterTouchStartY = e.touches[0].clientY;
    mobileFilterTouchCurrentY = mobileFilterTouchStartY;
  }, { passive: true });
  
  panel.addEventListener('touchmove', function(e) {
    mobileFilterTouchCurrentY = e.touches[0].clientY;
    const deltaY = mobileFilterTouchCurrentY - mobileFilterTouchStartY;
    if (deltaY > 0) {
      panel.style.transform = 'translateY(' + deltaY + 'px)';
    }
  }, { passive: true });
  
  panel.addEventListener('touchend', function(e) {
    const deltaY = mobileFilterTouchCurrentY - mobileFilterTouchStartY;
    if (deltaY > 100) {
      closeMobileFilter();
    }
    panel.style.transform = '';
  }, { passive: true });
}

// ===================== 初始化 =====================
document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('modal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });
  document.getElementById('filter-keyword').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') applyFilters();
  });
  document.getElementById('mobile-filter-keyword').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') applyMobileFilters();
  });
  ['filter-sentiment', 'filter-source', 'filter-category'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', applyFilters);
  });

  // fallback 数据：按舆情发生日期（date）过滤最近7天
  const todayStr = getTodayBeijing();
  const weekAgoStr = getDateStrBefore(todayStr, 6);
  const fbRecords = fallbackData.records || [];
  const weekRecords = fbRecords.filter(function(r) {
    var d = (r.date || r.publishTime || '').toString().slice(0, 10);
    return d >= weekAgoStr && d <= todayStr;
  });

  if (weekRecords.length > 0) {
    var stats = computeStats(weekRecords);
    loadedData = {
      reportDate: weekAgoStr + ' ~ ' + todayStr,
      records: weekRecords,
      summary: stats.summary,
      bySentiment: stats.bySentiment,
      bySource: stats.bySource,
      byRisk: stats.byRisk,
      byProduct: stats.byProduct,
      trend7d: computeTrend(weekRecords, weekAgoStr, todayStr),
      hotKeywords: fallbackData.hotKeywords || []
    };
  } else {
    loadedData = fallbackData;
  }

  document.getElementById('filter-date-start').value = weekAgoStr;
  document.getElementById('filter-date-end').value = todayStr;
  // 默认显示全部（不预设负面筛选）
  applyFilters();
  updateUI();
  renderCategoryBar();

  // 后台尝试加载最新数据（不阻塞页面显示）
  loadLatest();
});

</script>
</body>
</html>