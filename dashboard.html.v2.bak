<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>运营活动客户舆情雷达</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════════
   运营活动客户舆情看板 — 深色终端风格
   设计风格：金融终端与编辑排版的融合
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

:root {
  --bg: #0b1220;
  --bg-elevated: #111a2b;
  --bg-card: #111d2e;
  --bg-card-hover: #162438;
  --border: #2b3a57;
  --border-light: #3a4f75;
  --text: #f3f6ff;
  --text-muted: #aec0df;
  --text-dim: #88a0c7;
  --accent: #57b3ff;
  --accent-light: #8cc8ff;
  --accent-glow: rgba(87, 179, 255, 0.15);
  --gold: #f6b84b;
  --green: #37c486;
  --orange: #ff9800;
  --bad: #ef6678;
  --font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
  --font-body: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --radius: 12px;
  --radius-sm: 8px;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.4);
  --shadow-glow: 0 0 30px var(--accent-glow);
  --shadow-panel: 0 10px 30px rgba(0,0,0,0.35);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-body);
  background: radial-gradient(circle at top right, #12213d 0%, var(--bg) 45%), var(--bg);
  color: var(--text);
  line-height: 1.6;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
}

/* ── Noise Texture Overlay ── */
.noise-overlay {
  position: fixed; inset: 0; pointer-events: none; z-index: 9999;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 200px 200px;
}

/* ── Animation System ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-20px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes countUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); }
  50% { box-shadow: 0 0 20px 4px var(--accent-glow); }
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.animate-in {
  opacity: 0;
  animation: fadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

[data-delay="1"] { animation-delay: 0.08s; }
[data-delay="2"] { animation-delay: 0.16s; }
[data-delay="3"] { animation-delay: 0.24s; }
[data-delay="4"] { animation-delay: 0.32s; }
[data-delay="5"] { animation-delay: 0.40s; }
[data-delay="6"] { animation-delay: 0.48s; }
[data-delay="7"] { animation-delay: 0.56s; }
[data-delay="8"] { animation-delay: 0.64s; }
[data-delay="9"] { animation-delay: 0.72s; }

/* ── App Layout ── */
.app {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 32px 48px;
}

@media (max-width: 768px) {
  .app { padding: 0 16px 32px; }
}

/* ── Masthead ── */
.masthead {
  padding: 40px 0 32px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 32px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 16px;
}

.masthead-brand {
  display: flex;
  align-items: center;
  gap: 16px;
}

.masthead-icon {
  width: 48px; height: 48px;
  background: var(--accent);
  border-radius: var(--radius);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
  color: white;
  flex-shrink: 0;
  box-shadow: var(--shadow-glow);
}

.masthead h1 {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.masthead-sub {
  font-size: 13px;
  color: var(--text-muted);
  margin-top: 4px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.masthead-meta {
  text-align: right;
}

.masthead-date {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 600;
  color: var(--accent-light);
  letter-spacing: -0.01em;
}

.masthead-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 6px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.masthead-badge::before {
  content: '';
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--green);
  animation: pulseGlow 2s ease-in-out infinite;
}

/* ── Summary Card ── */
.summary-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 32px;
  margin-bottom: 32px;
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}

.summary-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--accent);
}

.summary-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--accent-light);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.summary-body {
  font-size: 15px;
  line-height: 1.85;
  color: var(--text);
}

.summary-body strong {
  color: var(--accent-light);
  font-weight: 600;
}

.summary-meta {
  font-size: 12px;
  color: var(--text-dim);
  margin-top: 14px;
  letter-spacing: 0.02em;
}

/* ── KPI Section ── */
.kpi-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

@media (max-width: 900px) {
  .kpi-section { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .kpi-section { grid-template-columns: repeat(2, 1fr); gap: 12px; }
}

.kpi-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 20px;
  position: relative;
  overflow: hidden;
  transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  box-shadow: var(--shadow-panel);
}

.kpi-card:hover {
  border-color: var(--border-light);
  transform: translateY(-2px);
  box-shadow: 0 10px 40px rgba(0,0,0,0.45);
}

.kpi-card.accent {
  border-color: rgba(87, 179, 255, 0.45);
  background: linear-gradient(135deg, var(--bg-card) 0%, rgba(87, 179, 255, 0.06) 100%);
}

.kpi-card.accent::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 80px; height: 80px;
  background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
  pointer-events: none;
}

.kpi-card.accent-negative {
  border-color: rgba(239, 102, 120, 0.35);
  background: linear-gradient(135deg, var(--bg-card) 0%, rgba(239, 102, 120, 0.06) 100%);
}

.kpi-card.accent-negative .kpi-big {
  color: var(--bad);
}

.kpi-card.accent-positive {
  border-color: rgba(55, 196, 134, 0.35);
  background: linear-gradient(135deg, var(--bg-card) 0%, rgba(55, 196, 134, 0.06) 100%);
}

.kpi-card.accent-positive .kpi-big {
  color: var(--green);
}

.kpi-sublabel {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-dim);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.kpi-big {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--text);
  animation: countUp 0.6s ease-out both;
}

.kpi-card.accent .kpi-big {
  color: var(--accent-light);
}

.kpi-detail {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 6px;
}

.kpi-detail span {
  color: var(--text);
  font-weight: 500;
}

/* ── Filter Section ── */
.filter-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 24px;
  margin-bottom: 24px;
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  align-items: center;
}

.filter-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.filter-label {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-dim);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.filter-input, .filter-select {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 12px;
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--text);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.filter-input:focus, .filter-select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}

.filter-input::placeholder {
  color: var(--text-dim);
}

.filter-select option {
  background: var(--bg-card);
  color: var(--text);
}

.btn {
  padding: 8px 20px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

.btn-primary:hover {
  background: var(--accent-light);
  border-color: var(--accent-light);
  box-shadow: var(--shadow-glow);
}

.btn-secondary {
  background: transparent;
  border-color: var(--border-light);
  color: var(--text-muted);
}

.btn-secondary:hover {
  border-color: var(--text-muted);
  color: var(--text);
}

/* ── Charts Section ── */
.charts-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}

.chart-panel {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-panel);
}

.chart-panel.wide {
  grid-column: 1 / -1;
}

@media (max-width: 900px) {
  .charts-section { grid-template-columns: 1fr; }
  .chart-panel.wide { grid-column: auto; }
}

.panel-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.panel-number {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}

.panel-header h3 {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.panel-body {
  min-height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Donut Chart ── */
.donut-container {
  display: flex;
  align-items: center;
  gap: 28px;
  width: 100%;
}

.donut-chart {
  width: 140px; height: 140px;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.donut-center {
  position: absolute;
  inset: 18px;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.donut-center-value {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.donut-center-label {
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-top: 2px;
}

.donut-legend {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

.donut-legend-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
}

.donut-legend-bar {
  width: 8px; height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}

.donut-legend-text {
  color: var(--text-muted);
}

.donut-legend-count {
  margin-left: auto;
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}

/* ── Bar Chart ── */
.bar-chart-dark {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.bar-dark-item {
  display: flex;
  align-items: center;
  gap: 14px;
}

.bar-dark-label {
  font-size: 12px;
  color: var(--text-muted);
  min-width: 60px;
  text-align: right;
}

.bar-dark-track {
  flex: 1;
  height: 8px;
  background: var(--bg-elevated);
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}

.bar-dark-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}

.bar-dark-fill::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 50%, transparent 100%);
  background-size: 200% 100%;
  animation: shimmer 2s linear infinite;
}

.bar-dark-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  min-width: 24px;
  text-align: left;
}

/* ── Line Chart ── */
.line-chart-dark {
  width: 100%;
  height: 200px;
  position: relative;
}

.line-chart-dark svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.line-chart-dark .grid-line {
  stroke: var(--border);
  stroke-width: 1;
  stroke-dasharray: 4 4;
}

.line-chart-dark .axis-text {
  fill: var(--text-dim);
  font-size: 10px;
  font-family: var(--font-body);
}

.line-chart-dark .trend-area {
  fill: url(#trendGradient);
}

.line-chart-dark .trend-line {
  fill: none;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.line-chart-dark .trend-line.total {
  stroke: var(--text-muted);
  stroke-dasharray: 6 4;
}

.line-chart-dark .trend-line.negative {
  stroke: var(--accent);
}

.line-chart-dark .trend-point {
  transition: r 0.2s;
  cursor: pointer;
}

.line-chart-dark .trend-point:hover {
  r: 5;
}

.line-chart-dark .trend-tooltip {
  position: absolute;
  background: var(--bg-elevated);
  border: 1px solid var(--border-light);
  border-radius: var(--radius);
  padding: 8px 12px;
  font-size: 11px;
  color: var(--text);
  pointer-events: none;
  z-index: 10;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.2s;
  box-shadow: var(--shadow-md);
}

/* ── Trend Legend ── */
.trend-legend {
  display: flex;
  justify-content: center;
  gap: 24px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
  margin-top: 8px;
}

.trend-legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-muted);
}

.trend-legend-line {
  display: inline-block;
  width: 20px;
  height: 2px;
  border-radius: 1px;
}

.trend-legend-total {
  background: none;
  border-top: 2px dashed var(--text-muted);
  height: 0;
  width: 20px;
}

.trend-legend-negative {
  background: var(--accent);
  height: 3px;
  border-radius: 2px;
}

/* ── Word Cloud ── */
.word-cloud-dark {
  display: flex;
  flex-wrap: wrap;
  align-content: center;
  justify-content: center;
  gap: 8px;
  padding: 8px;
}

.word-item-dark {
  display: inline-block;
  padding: 6px 16px;
  border-radius: 100px;
  font-weight: 500;
  font-size: 13px;
  transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  cursor: default;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--text-muted);
}

.word-item-dark:hover {
  transform: scale(1.06) translateY(-2px);
  border-color: var(--accent);
  color: var(--accent-light);
  box-shadow: var(--shadow-glow);
  background: rgba(196,30,58,0.08);
}

/* ── Data Table ── */
.table-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-panel);
}

.table-header {
  padding: 20px 24px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.table-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.table-count {
  font-size: 12px;
  color: var(--text-dim);
}

.table-count span {
  color: var(--accent-light);
  font-weight: 600;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead {
  background: var(--bg-elevated);
}

th {
  padding: 14px 20px;
  text-align: left;
  font-size: 10px;
  font-weight: 600;
  color: var(--text-dim);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  user-select: none;
  transition: color 0.2s;
}

th:hover {
  color: var(--text-muted);
}

td {
  padding: 14px 20px;
  font-size: 13px;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
  color: var(--text-muted);
  transition: background 0.15s;
}

tr:hover td {
  background: rgba(255,255,255,0.02);
}

tr {
  transition: border-left 0.15s;
  border-left: 2px solid transparent;
}

tr:hover {
  border-left-color: var(--accent);
}

/* ── Tags ── */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 500;
  gap: 4px;
  letter-spacing: 0.02em;
}

.tag-sentiment-positive { background: rgba(76,175,80,0.12); color: var(--green); border: 1px solid rgba(76,175,80,0.2); }
.tag-sentiment-negative { background: rgba(196,30,58,0.12); color: var(--accent-light); border: 1px solid rgba(196,30,58,0.2); }
.tag-sentiment-neutral { background: rgba(255,152,0,0.08); color: var(--orange); border: 1px solid rgba(255,152,0,0.15); }
.tag-recency-recent { background: rgba(245,166,35,0.08); color: var(--gold); border: 1px solid rgba(245,166,35,0.15); }
.tag-recency-history { background: rgba(85,85,102,0.15); color: var(--text-dim); border: 1px solid var(--border); }

/* ── Category Tags ── */
.tag-category-i豆兑换 { background: rgba(87,179,255,0.12); color: var(--accent-light); border: 1px solid rgba(87,179,255,0.2); }
.tag-category-薅羊毛 { background: rgba(246,184,75,0.12); color: var(--gold); border: 1px solid rgba(246,184,75,0.2); }
.tag-category-资产达标 { background: rgba(55,196,134,0.12); color: var(--green); border: 1px solid rgba(55,196,134,0.2); }
.tag-category-投诉维权 { background: rgba(239,102,120,0.12); color: #ef6678; border: 1px solid rgba(239,102,120,0.2); }
.tag-category-虚假宣传 { background: rgba(156,39,176,0.12); color: #ce93d8; border: 1px solid rgba(156,39,176,0.2); }
.tag-category-其他 { background: rgba(136,160,199,0.12); color: var(--text-dim); border: 1px solid var(--border); }

/* ── Heat Score ── */
.heat-score { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; font-size: 13px; color: var(--gold); }
.heat-score-high { color: #ff6b6b; }
.heat-metrics { display: flex; gap: 8px; font-size: 11px; color: var(--text-dim); margin-top: 2px; }
.heat-metrics span { display: inline-flex; align-items: center; gap: 2px; }

/* ── Category Filter Bar ── */
.category-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; padding: 0 4px; }
.category-chip { padding: 5px 12px; border-radius: 100px; font-size: 12px; font-weight: 500; cursor: pointer; background: var(--bg-elevated); border: 1px solid var(--border); color: var(--text-muted); transition: all 0.2s; }
.category-chip:hover { border-color: var(--accent); color: var(--accent-light); }
.category-chip.active { background: var(--accent); color: #fff; border-color: var(--accent); box-shadow: 0 0 12px var(--accent-glow); }

/* ── Content Preview ── */
.content-preview {
  max-width: 400px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: var(--text-muted);
  line-height: 1.5;
}

.link-btn {
  color: var(--accent-light);
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
  transition: opacity 0.2s;
}

.link-btn:hover {
  opacity: 0.7;
  text-decoration: underline;
}

/* ── Pagination ── */
.pagination {
  padding: 14px 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4px;
  border-top: 1px solid var(--border);
}

.page-btn {
  padding: 6px 12px;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  border-radius: var(--radius);
  font-size: 12px;
  font-family: var(--font-body);
  cursor: pointer;
  color: var(--text-muted);
  transition: all 0.2s;
}

.page-btn:hover {
  border-color: var(--border-light);
  color: var(--text);
  background: var(--bg-card);
}

.page-btn.active {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

.page-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

/* ── Modal ── */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(8px);
  z-index: 1000;
  justify-content: center;
  align-items: center;
  padding: 40px 20px;
}

.modal-overlay.active { display: flex; }

.modal {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 100%;
  max-width: 680px;
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}

.modal-header {
  padding: 20px 24px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  color: var(--text);
}

.modal-close {
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  cursor: pointer;
  font-size: 16px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.modal-close:hover {
  border-color: var(--accent);
  color: var(--accent-light);
  background: rgba(196,30,58,0.1);
}

.modal-body {
  padding: 24px;
  overflow-y: auto;
  flex: 1;
}

.detail-row {
  display: flex;
  margin-bottom: 14px;
  gap: 16px;
}

.detail-label {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-dim);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  min-width: 80px;
  padding-top: 2px;
}

.detail-value {
  font-size: 14px;
  color: var(--text);
  flex: 1;
  line-height: 1.5;
}

.detail-content {
  background: var(--bg-elevated);
  padding: 16px;
  border-radius: var(--radius);
  font-size: 14px;
  line-height: 1.8;
  color: var(--text-muted);
  border: 1px solid var(--border);
}

.timeline {
  position: relative;
  padding-left: 20px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 5px; top: 0; bottom: 0;
  width: 1px;
  background: var(--border);
}

.timeline-item {
  position: relative;
  margin-bottom: 16px;
  padding-left: 16px;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -16px; top: 4px;
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  border: 2px solid var(--bg-card);
}

.timeline-time {
  font-size: 11px;
  color: var(--text-dim);
  margin-bottom: 2px;
  font-family: var(--font-body);
}

.timeline-text {
  font-size: 13px;
  color: var(--text-muted);
}

.empty-state {
  padding: 60px 24px;
  text-align: center;
  color: var(--text-dim);
  font-size: 14px;
}

/* ── Mobile Card List ── */
.mobile-card-list {
  display: none;
  gap: 8px;
  padding: 12px;
}

.mobile-card {
  border: 1px solid rgba(59, 79, 113, 0.6);
  border-radius: var(--radius-sm);
  background: rgba(22, 34, 56, 0.72);
  padding: 14px 16px;
  display: grid;
  gap: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.mobile-card:active {
  background: rgba(87, 179, 255, 0.08);
}

.mobile-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: space-between;
}

.mobile-card-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.mobile-card-title {
  font-size: 15px;
  color: var(--text);
  line-height: 1.4;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mobile-card-content {
  font-size: 13px;
  color: var(--text-dim);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mobile-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  font-size: 12px;
  color: var(--text-dim);
}

.mobile-card-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.mobile-card-tag {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  border: 1px solid rgba(87, 179, 255, 0.25);
  background: rgba(87, 179, 255, 0.06);
  font-size: 11px;
  color: var(--text-soft);
}

.mobile-pagination {
  display: none;
  padding: 12px;
  gap: 6px;
  flex-direction: column;
  align-items: flex-start;
  font-size: 12px;
}

/* ── Mobile Filter Panel ── */
.filter-mobile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(4, 8, 15, 0.6);
  z-index: 50;
  display: none;
}

.filter-mobile-overlay:not([hidden]) {
  display: block;
}

.filter-mobile-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  top: 12vh;
  z-index: 51;
  background: #0f1829;
  border-radius: 16px 16px 0 0;
  grid-template-rows: auto 1fr auto;
  overflow: hidden;
  display: none;
}

.filter-mobile-panel:not([hidden]) {
  display: grid;
}

.filter-mobile-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  font-size: 17px;
  font-weight: 600;
  border-bottom: 1px solid var(--border);
}

.filter-mobile-panel-close {
  border: none;
  background: transparent;
  color: var(--text-soft);
  font-size: 24px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
}

.filter-mobile-panel-body {
  overflow-y: auto;
  padding: 16px 20px;
  display: grid;
  gap: 14px;
  -webkit-overflow-scrolling: touch;
}

.filter-mobile-panel-body .filter-group {
  display: grid;
  gap: 6px;
  align-items: start;
}

.filter-mobile-panel-body .filter-label {
  font-size: 12px;
}

.filter-mobile-panel-body .filter-input,
.filter-mobile-panel-body .filter-select {
  width: 100%;
  height: 40px;
}

.filter-mobile-panel-footer {
  display: flex;
  gap: 12px;
  padding: 14px 20px;
  border-top: 1px solid var(--border);
  background: rgba(17, 26, 43, 0.95);
}

.filter-mobile-panel-footer .btn {
  flex: 1;
  height: 44px;
  font-size: 15px;
}

.toolbar-mobile-hint {
  display: none;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--text-soft);
  font-size: 12px;
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid rgba(87, 179, 255, 0.18);
  background: rgba(87, 179, 255, 0.06);
  margin: -4px 0 4px;
}

.toolbar-overflow-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-elevated);
  color: var(--text-dim);
  cursor: pointer;
}

.toolbar-overflow-btn:hover {
  border-color: #4f6ba0;
  color: var(--text);
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .app { padding: 0 12px 24px; }

  .masthead {
    padding: 24px 0 20px;
    margin-bottom: 20px;
  }

  .masthead h1 {
    font-size: 22px;
  }

  .masthead-icon {
    width: 36px; height: 36px;
    font-size: 16px;
  }

  .masthead-date {
    font-size: 18px;
  }

  .filter-section {
    padding: 14px 16px;
    gap: 10px;
  }

  .filter-section .filter-desktop {
    display: none;
  }

  .charts-section {
    gap: 12px;
  }

  .chart-panel {
    padding: 16px;
    border-radius: var(--radius-sm);
  }

  .table-section table,
  .table-section thead,
  .table-section tbody,
  .table-section tr,
  .table-section th,
  .table-section td {
    display: none;
  }

  .table-section .mobile-card-list {
    display: grid;
  }

  .table-section .pagination {
    display: none;
  }

  .table-section .mobile-pagination {
    display: flex;
  }

  .toolbar-mobile-hint {
    display: flex;
  }

  .toolbar-overflow-btn {
    display: inline-flex;
  }

  .modal-overlay {
    padding: 0;
    align-items: flex-end;
  }

  .modal {
    max-width: 100vw;
    border-radius: 16px 16px 0 0;
    border-left: none;
    border-right: none;
    border-bottom: none;
    max-height: 90vh;
  }
}

@media (max-width: 600px) {
  .kpi-section {
    grid-template-columns: 1fr;
  }

  .charts-section {
    grid-template-columns: 1fr;
  }

  .chart-panel.wide {
    grid-column: auto;
  }
}

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--border-light); }
</style>
</head>
<body>
<div class="noise-overlay"></div>

<div class="app">

  <!-- ═══ MASTHEAD ═══ -->
  <header class="masthead" data-delay="1">
    <div class="masthead-brand">
      <div class="masthead-icon">◉</div>
      <div>
        <h1>运营活动客户舆情雷达</h1>
        <div class="masthead-sub">客户舆情监测看板 · 升金有礼 & i豆活动</div>
      </div>
    </div>
  </header>

  <!-- ═══ SUMMARY ═══ -->
  <div class="summary-card" id="summary-card" style="display:none;">
    <div class="summary-label">每日简报</div>
    <div class="summary-body" id="summary-body">加载中...</div>
    <div class="summary-meta" id="summary-meta"></div>
  </div>

  <!-- ═══ 核心指标 ═══ -->
  <div class="kpi-section">
    <div class="kpi-card" data-delay="2">
      <div class="kpi-sublabel">舆情总量</div>
      <div class="kpi-big" id="kpi-total">--</div>
    </div>
    <div class="kpi-card" data-delay="3">
      <div class="kpi-sublabel">24h内新增</div>
      <div class="kpi-big" id="kpi-recent">--</div>
    </div>
    <div class="kpi-card accent-negative" data-delay="4">
      <div class="kpi-sublabel">需关注</div>
      <div class="kpi-big" id="kpi-negative">--</div>
    </div>
    <div class="kpi-card accent-positive" data-delay="5">
      <div class="kpi-sublabel">正面反馈</div>
      <div class="kpi-big" id="kpi-positive">--</div>
    </div>
  </div>

  <!-- ═══ FILTERS ═══ -->
  <div class="filter-section" data-delay="5">
    <div class="toolbar-mobile-hint" id="mobile-filter-hint">
      <span>👆 点击筛选查看条件</span>
      <button class="toolbar-overflow-btn" onclick="openMobileFilter()">☰</button>
    </div>
    <div class="filter-group filter-desktop">
      <span class="filter-label">时间</span>
      <input type="date" class="filter-input" id="filter-date-start" style="width:130px;">
      <span style="color:var(--text-dim);font-size:12px;">→</span>
      <input type="date" class="filter-input" id="filter-date-end" style="width:130px;">
    </div>
    <div class="filter-group filter-desktop">
      <span class="filter-label">关键词</span>
      <input type="text" class="filter-input" id="filter-keyword" placeholder="搜索..." style="width:140px;">
    </div>
    <div class="filter-group filter-desktop">
      <span class="filter-label">情感</span>
      <select class="filter-select" id="filter-sentiment">
        <option value="">全部</option>
        <option value="positive">正面</option>
        <option value="negative">负面</option>
        <option value="neutral">中性</option>
      </select>
    </div>
    <div class="filter-group filter-desktop">
      <span class="filter-label">来源</span>
      <select class="filter-select" id="filter-source">
        <option value="">全部</option>
        <option value="social">微博</option>
        <option value="xiaohongshu">小红书</option>
        <option value="news">新闻媒体</option>
        <option value="complaint">投诉平台</option>
        <option value="forum">论坛社区</option>
        <option value="official">官方</option>
      </select>
    </div>
    <div class="filter-group filter-desktop">
      <span class="filter-label">类别</span>
      <select class="filter-select" id="filter-category">
        <option value="">全部</option>
        <option value="i豆兑换">i豆兑换</option>
        <option value="薅羊毛">薅羊毛</option>
        <option value="资产达标">资产达标</option>
        <option value="投诉维权">投诉维权</option>
        <option value="虚假宣传">虚假宣传</option>
        <option value="其他">其他</option>
      </select>
    </div>
    <div class="filter-group" style="margin-left:auto;">
      <button class="btn btn-secondary" onclick="resetFilters()">重置</button>
      <button class="btn btn-primary" onclick="onQuery()">查询</button>
    </div>
  </div>

  <!-- ═══ CHARTS ═══ -->
  <div class="charts-section">
    <div class="chart-panel" data-delay="6">
      <div class="panel-header">
        <span class="panel-number">01</span>
        <h3>情感分布</h3>
      </div>
      <div class="panel-body" id="sentiment-chart"></div>
    </div>
    <div class="chart-panel" data-delay="7">
      <div class="panel-header">
        <span class="panel-number">02</span>
        <h3>来源渠道</h3>
      </div>
      <div class="panel-body" id="source-chart"></div>
    </div>
    <div class="chart-panel wide" data-delay="8">
      <div class="panel-header">
        <span class="panel-number">03</span>
        <h3>舆情趋势（5月以来）</h3>
      </div>
      <div class="panel-body" id="trend-chart"></div>
    </div>
    <div class="chart-panel wide" data-delay="9">
      <div class="panel-header">
        <span class="panel-number">04</span>
        <h3>热词云</h3>
      </div>
      <div class="panel-body" id="word-cloud"></div>
    </div>
  </div>

  <!-- ═══ CATEGORY BAR ═══ -->
  <div class="category-bar" id="category-bar" data-delay="8"></div>

  <!-- ═══ DATA TABLE ═══ -->
  <div class="table-section" data-delay="9">
    <div class="table-header">
      <div class="table-title">舆情列表</div>
      <div class="table-count">共 <span id="total-count">--</span> 条记录</div>
    </div>
    <table>
      <thead>
        <tr>
          <th style="width:100px;" onclick="sortTable('date')" data-sort="date">时间</th>
          <th style="width:90px;" onclick="sortTable('sourceType')" data-sort="sourceType">来源</th>
          <th style="width:80px;" onclick="sortTable('category')" data-sort="category">类别</th>
          <th style="width:80px;" onclick="sortTable('heatScore')" data-sort="heatScore">热度</th>
          <th style="width:70px;" onclick="sortTable('sentiment')" data-sort="sentiment">情感</th>
          <th>内容摘要</th>
          <th style="width:100px;">关键词</th>
          <th style="width:60px;">操作</th>
        </tr>
      </thead>
      <tbody id="data-tbody"></tbody>
    </table>
    <div class="mobile-card-list" id="mobile-card-list"></div>
    <div class="pagination" id="pagination"></div>
    <div class="mobile-pagination" id="mobile-pagination"></div>
  </div>

</div>

<!-- ═══ MOBILE FILTER PANEL ═══ -->
<div class="filter-mobile-overlay" id="mobile-filter-overlay" hidden onclick="closeMobileFilter()"></div>
<div class="filter-mobile-panel" id="mobile-filter-panel" hidden>
  <div class="filter-mobile-panel-head">
    <span>筛选条件</span>
    <button class="filter-mobile-panel-close" onclick="closeMobileFilter()">×</button>
  </div>
  <div class="filter-mobile-panel-body">
    <div class="filter-group">
      <span class="filter-label">时间范围</span>
      <input type="date" class="filter-input" id="mobile-filter-date-start">
      <input type="date" class="filter-input" id="mobile-filter-date-end" style="margin-top:6px;">
    </div>
    <div class="filter-group">
      <span class="filter-label">关键词</span>
      <input type="text" class="filter-input" id="mobile-filter-keyword" placeholder="搜索标题或内容...">
    </div>
    <div class="filter-group">
      <span class="filter-label">情感</span>
      <select class="filter-select" id="mobile-filter-sentiment">
        <option value="">全部</option>
        <option value="positive">正面</option>
        <option value="negative">负面</option>
        <option value="neutral">中性</option>
      </select>
    </div>
    <div class="filter-group">
      <span class="filter-label">来源</span>
      <select class="filter-select" id="mobile-filter-source">
        <option value="">全部</option>
        <option value="social">微博</option>
        <option value="xiaohongshu">小红书</option>
        <option value="news">新闻媒体</option>
        <option value="complaint">投诉平台</option>
        <option value="forum">论坛社区</option>
        <option value="official">官方</option>
      </select>
    </div>
    <div class="filter-group">
      <span class="filter-label">类别</span>
      <select class="filter-select" id="mobile-filter-category">
        <option value="">全部</option>
        <option value="i豆兑换">i豆兑换</option>
        <option value="薅羊毛">薅羊毛</option>
        <option value="资产达标">资产达标</option>
        <option value="投诉维权">投诉维权</option>
        <option value="虚假宣传">虚假宣传</option>
        <option value="其他">其他</option>
      </select>
    </div>
  </div>
  <div class="filter-mobile-panel-footer">
    <button class="btn btn-secondary" onclick="resetMobileFilters()">重置</button>
    <button class="btn btn-primary" onclick="applyMobileFilters()">确认筛选</button>
  </div>
</div>

<!-- ═══ MODAL ═══ -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="modal-title">舆情详情</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body" id="modal-body"></div>
  </div>
